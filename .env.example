# Copy to .env for local testing. On Render, enter the same keys under Environment.
# The key comes from the OLake event (sent on Slack, starts with sk-or-v1-). Never commit it.
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# Only these three models work on the event key (any other model returns 403)
LLM_MODEL=z-ai/glm-4.7-flash
LLM_FALLBACK_MODELS=google/gemini-2.5-flash-lite,deepseek/deepseek-v4.1-flash
MAX_ANSWER_TOKENS=500
# Local embedding model (runs inside our server, no API cost); empty = keyword (BM25) search only
EMBEDDING_MODEL=minishlab/potion-base-8M
